#!/usr/bin/env zsh
set -euo pipefail

readonly ROOT="${${0:A}:h:h}"
# What the public repo must never contain, kept in the local tier so the detector
# itself cannot leak. Absent on a machine without that tier: the greps are no-ops.
readonly DENYLIST="${XDG_DATA_HOME:-${HOME}/.local/share}/plugged/denylist.txt"
readonly TARGET="${XDG_CACHE_HOME:-${HOME}/.cache}/plugged/target"
readonly c_red=$'\e[31m' c_green=$'\e[32m' c_rst=$'\e[0m'
log::info() { print -u2 -- "[INFO] $*"; }
log::ok()   { print -u2 -- "${c_green}[OK]${c_rst} $*"; }
log::err()  { print -u2 -- "${c_red}[ERROR]${c_rst} $*"; }

usage() {
  cat <<'USAGE'
usage: plugged-dev <build|test [--update]|check>
  build   release build into $XDG_CACHE_HOME/plugged/target, with cargo from PATH or, without
          one, from nixpkgs for the length of the build; clippy's warnings fail it
  test    the spec's tests (docs/SPEC.md): this machine's `plugged json` against tests/conform.jq,
          then every recorded machine under tests/fixtures (a sysfs tree) and every recorded
          snapshot under tests/snapshots (a JSON document) against its expected JSON, text and
          dashboard frame; --update rewrites the expected files from the current build
  check   build, test, validate `plugged json` with jq, round-trip it through `plugged tui -`,
          render `plugged text`, grep tracked files and the commit identity against the denylist
USAGE
}

# cargo from PATH, else the one nixpkgs has, fetched for this run and installed nowhere.
cargo_run() {
  if command -v cargo >/dev/null; then
    cargo "$@"
  elif command -v nix >/dev/null; then
    nix shell nixpkgs#cargo nixpkgs#rustc nixpkgs#clippy --command cargo "$@"
  else
    log::err "no cargo on PATH and no nix to fetch one"
    return 1
  fi
}

build() {
  log::info "cargo clippy, cargo build --release | target='${TARGET}'"
  cargo_run clippy --quiet --release --manifest-path "${ROOT}/Cargo.toml" --target-dir "${TARGET}" -- -D warnings
  cargo_run build --quiet --release --locked --manifest-path "${ROOT}/Cargo.toml" --target-dir "${TARGET}"
}

# The denylist as grep -e arguments, comment and blank lines dropped. An array, not a
# pattern file: xargs may run grep more than once and a pipe can only be read once.
denylist_args() {
  local -a lines
  lines=("${(@f)$(grep -vE '^#|^$' "${DENYLIST}")}")
  local line
  for line in "${lines[@]}"; do
    [[ -n "${line}" ]] && print -r -- "-e" && print -r -- "${line}"
  done
}

check_leaks() {
  if [[ ! -r "${DENYLIST}" ]]; then
    log::info "leak grep skipped: no denylist | path='${DENYLIST}'"
    return 0
  fi
  local -a args
  args=("${(@f)$(denylist_args)}")
  (( ${#args} > 0 )) || return 0
  local hits
  hits="$(git -C "${ROOT}" ls-files -z | xargs -0 grep -nEI "${args[@]}" -- 2>/dev/null || true)"
  if [[ -n "${hits}" ]]; then
    log::err "denylisted identifiers in tracked files | denylist='${DENYLIST}'"
    print -u2 -r -- "${hits}"
    return 1
  fi
  log::info "leak grep clean"
}

check_identity() {
  [[ -r "${DENYLIST}" ]] || return 0
  local -a args
  args=("${(@f)$(denylist_args)}")
  (( ${#args} > 0 )) || return 0
  local email
  email="$(git -C "${ROOT}" config user.email || true)"
  if print -r -- "${email}" | grep -qE "${args[@]}"; then
    log::err "commit identity matches the denylist | user.email='${email}' fix='git -C ${ROOT} config user.email <personal address>'"
    return 1
  fi
  log::info "commit identity ok"
}

# A snapshot with the two fields that differ per run pinned, so it compares across runs.
stable_json() { jq -S '.generatedAt = "2026-01-01T00:00:00Z" | .host = "fixture"'; }

# The frame is compared this wide and uncolored.
readonly FRAME_WIDTH=84

# compare <expected file> <what it is> <name>: stdin against the file, or the file rewritten.
compare() {
  local expected="$1" what="$2" name="$3" actual
  actual="$(cat)"
  if [[ "${UPDATE}" == "--update" ]]; then
    print -r -- "${actual}" > "${expected}"
    return 0
  fi
  diff -u "${expected}" <(print -r -- "${actual}") && return 0
  log::err "${what} differs from ${expected:t} | case='${name}'"
  return 1
}

# One snapshot document, checked against the spec and its three expected renderings.
check_document() {
  local document="$1" dir="$2" stem="$3" name="$4" failed=0
  print -r -- "${document}" | jq -e -f "${ROOT}/tests/conform.jq" >/dev/null || { log::err "json breaks the spec | case='${name}'"; failed=1; }
  print -r -- "${document}" | "${ROOT}/bin/plugged" tui - | compare "${dir}/${stem}.txt" "text" "${name}" || failed=1
  print -r -- "${document}" | "${ROOT}/bin/plugged" tui - --width "${FRAME_WIDTH}" | compare "${dir}/${stem}.frame.txt" "dashboard frame" "${name}" || failed=1
  return "${failed}"
}

run_tests() {
  UPDATE="${1:-}"
  local failed=0 fixture snapshot name document
  log::info "conform: this machine's plugged json"
  "${ROOT}/bin/plugged" json | jq -e -f "${ROOT}/tests/conform.jq" >/dev/null || { log::err "this machine's json breaks the spec | see='tests/conform.jq'"; failed=1; }
  # Recorded machines: a sysfs tree the Linux collectors read on any platform.
  for fixture in "${ROOT}"/tests/fixtures/*(/N); do
    name="${fixture:t}"
    document="$(PLUGGED_SYSFS_ROOT="${fixture}/sys" "${ROOT}/bin/plugged" json | stable_json)"
    print -r -- "${document}" | compare "${fixture}/expected.json" "json" "${name}" || failed=1
    check_document "${document}" "${fixture}" expected "${name}" || failed=1
    log::info "fixture checked | fixture='${name}'"
  done
  # Recorded snapshots: a document from any platform, rendered here.
  for snapshot in "${ROOT}"/tests/snapshots/*.json(N); do
    name="${snapshot:t:r}"
    check_document "$(<"${snapshot}")" "${snapshot:h}" "${name}" "${name}" || failed=1
    log::info "snapshot checked | snapshot='${name}'"
  done
  [[ "${UPDATE}" == "--update" ]] && log::info "expected files rewritten; read the diff"
  return "${failed}"
}

check() {
  if ! command -v jq >/dev/null; then
    log::err "jq is required for check"
    return 1
  fi
  build
  log::info "plugged json | jq -e ."
  "${ROOT}/bin/plugged" json | jq -e . >/dev/null
  log::info "plugged json | plugged tui -"
  "${ROOT}/bin/plugged" json | "${ROOT}/bin/plugged" tui - >/dev/null
  log::info "plugged text"
  "${ROOT}/bin/plugged" text
  run_tests
  check_leaks
  check_identity
  log::ok "build, json, tui round-trip, text, spec tests, leak grep and identity all passed"
}

case "${1:-}" in
  build) build ;;
  test) build; run_tests "${2:-}" && log::ok "spec tests passed" ;;
  check) check ;;
  -h|--help|help) usage ;;
  "") usage >&2; exit 2 ;;
  *) log::err "unknown command: $1"; usage >&2; exit 2 ;;
esac
