#!/usr/bin/env zsh
# Builds the release binary when it is missing or older than any source, then runs it: the
# working tree, uncommitted edits included. The build lives under $XDG_CACHE_HOME/plugged, never
# in the checkout.
set -euo pipefail

readonly ROOT="${${0:A}:h:h}"
readonly BINARY="${XDG_CACHE_HOME:-${HOME}/.cache}/plugged/target/release/plugged"

needs_build() {
  [[ -x "${BINARY}" ]] || return 0
  local source
  for source in "${ROOT}/Cargo.toml" "${ROOT}/Cargo.lock" "${ROOT}"/src/**/*.rs(N); do
    [[ "${source}" -nt "${BINARY}" ]] && return 0
  done
  return 1
}

if needs_build; then
  zsh "${ROOT}/bin/plugged-dev" build >&2
fi
exec "${BINARY}" "$@"
